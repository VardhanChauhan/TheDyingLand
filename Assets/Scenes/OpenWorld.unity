--- !u!114 &314108885
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 314108884}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3e156d8be06941142bd79fe65d20d3ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 73685685}
  dialogueText: {fileID: 1438757171}
  stopDialogues:
  - text: 'If you forget the road, your people may starve.

      But if you remember
      it, someone else surely will.'
    voiceClip: {fileID: 8300000, guid: c3e2733d5b2eeca42a9b43efa1d327f2, type: 3}
    reputationLoss: 0
    memoryLost: 
  - text: "Strength keeps you alive today.\nBut tomorrow, who will carry the weak?\u201D"
    voiceClip: {fileID: 8300000, guid: 4515242a0f30afb48aa38bfaf783b365, type: 3}
    reputationLoss: 0
    memoryLost: 
  - text: 'Healing saves one soul now.

      But how many suffer when mercy runs
      dry?'
    voiceClip: {fileID: 8300000, guid: 88008c755895cd547aba40821f395158, type: 3}
    reputationLoss: 0
    memoryLost: 
  - text: 'Trust binds people together.

      But when it breaks, it cuts deeper
      than blades.'
    voiceClip: {fileID: 8300000, guid: d241ec591246d2f4da6fd82c1503eda4, type: 3}
    reputationLoss: 0
    memoryLost: 
  finalDialogue:
    text: 'Nothing remains to be traded.

      Only consequences walk forward.'
    voiceClip: {fileID: 8300000, guid: 4dc8975a95cb1dc4b8d9ffb1e9b56945, type: 3}
    reputationLoss: 0
    memoryLost: 
  tradeTimeLimit: 6
